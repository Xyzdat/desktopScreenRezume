    max-height: calc(100dvh - 48px);
    height: calc(100dvh - 48px);
  }

  &_minimized {
    width: min(360px, calc(100vw - 48px));
    height: 53px;
    max-height: 53px;
  }

  &__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    min-height: 52px;
    gap: 14px;
    padding: 0 18px;
    cursor: grab;
    touch-action: none;
    user-select: none;

    background: linear-gradient(#f7f7f7, #e9e9e9);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  &__controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  &__control {
    display: grid;
    place-items: center;
    width: 13px;
    height: 13px;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 50%;
    color: rgba(0, 0, 0, 0.62);
    cursor: pointer;
    font: 600 11px/1 Arial, sans-serif;

    span { opacity: 0; }

    &:hover span,
    &:focus-visible span { opacity: 1; }

    &:focus-visible {
      outline: 2px solid #3478f6;
      outline-offset: 2px;
    }

    &_close { background: #ff5f57; }
    &_minimize { background: #febc2e; }
    &_maximize { background: #28c840; }
  }

  &__title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    max-width: calc(100% - 120px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #343434;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  &__content {
    flex: 1;
    min-height: 0;
    max-height: min(650px, calc(100dvh - 101px));
    padding: 22px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 1;
    transition:
      max-height 320ms ease,
      padding 320ms ease,
      opacity 180ms ease;

    &_minimized {
      max-height: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 0;
    }
  }
