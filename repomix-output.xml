<file path="src/components/header/header.module.scss">
.header {
    position: fixed;
    left: 50%;
    top: 2px;
    transform: translateX(-50%);
    

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;

    width: min(900px, calc(100vw - 150px));
    min-height: 40px;
    box-sizing: border-box;

    // Liquid Glass
    background: rgba(255, 255, 255, 0.16);

    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);

    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 26px;

    box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.45),
        inset 0 -1px 0 rgba(255, 255, 255, 0.08);

    pointer-events: auto;

    z-index: 10000;

    transition: 2000ms cubic-bezier(0.22, 1, 0.25, 1),
                width 2000ms cubic-bezier(0.22, 1, 0.36, 1),
                height 2000ms cubic-bezier(0.22, 1, 0.36, 1),;

    
    // Мягкий блик вдоль верхней части панели
    &::before {
        content: "";
        position: absolute;
        inset: 0;

        border-radius: inherit;
        pointer-events: none;

        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.22) 0%,
            rgba(255, 255, 255, 0.05) 35%,
            transparent 70%
        );
    }

    &__item {
        display: grid;
        place-items: center;
        position: relative;
        z-index: 1;

        font-size: 12px;

        width: 150px;
        height: 30px;

        border-radius: 16px;

        padding: 5px;
        color: #242424;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
        cursor: pointer;
        text-decoration: none;
        transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
                    background 400ms ease;

        &:hover {
            transform:  scale(1.08);
            background: rgba(255, 255, 255, 0.95);
        }

        &:focus-visible {
            outline: 2px solid #3478f6;
            outline-offset: 3px;
        }

    }

}
</file>

<file path="src/components/header/header.tsx">
import styles from './header.module.scss'


type HeaderProps = {
  onItemClick: (id: string) => void;
};

const items = [
    { id: "experience", title: "Опыт работы" },
    { id: "projects", title: "Пет проекты" },
    { id: "education", title: "Образование" },
    { id: "skills", title: "Технический стэк" },
    { id: "contacts", title: "Контакты" },
]


const Header = ({onItemClick}: HeaderProps) => {
    return (
        <div className={styles.header}>
            {items.map((item) => (
                <button className={styles.header__item} key={item.id} onClick={() => onItemClick(item.id)}>{item.title}</button>
            )) }
        </div>
    )
}

export default Header;
</file>

