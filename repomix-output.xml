                    className={styles.notes}
                    value={notes}
                    onChange={(event) => updateNotes(event.target.value)}
                    placeholder="Напишите заметку…"
                    aria-label="Текст заметки"
                />
            </Modal>
        </>
    );
}

export default TaskPanel
