<file path="src/components/backgroundScene/backgroundScene.module.scss">
.scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #9ebbd7;

    &::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(224, 240, 255, 0.24),
            rgba(26, 45, 76, 0.13)
        );
        pointer-events: none;
    }

    &__canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
}
