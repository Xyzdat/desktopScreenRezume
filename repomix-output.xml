import {Phone} from "lucide-react"

const TaskPanel: FC = () => {
    const [notesOpen, setNotesOpen] = useState(false)
    const [notes, setNotes] = useState(() => localStorage.getItem('portfolio_notes') ?? '')

    const updateNotes = (value: string) => {
